// A Brainfuck interpreter written in Bork -- strings, arrays, and a
// precomputed bracket-jump table.

fn jump_table(program: str) -> [int] {
    var table: [int] = [];
    for i in 0..len(program) { push(table, 0); }

    var open_brackets: [int] = [];
    for i in 0..len(program) {
        let c = program[i];
        if c == "[" {
            push(open_brackets, i);
        } else if c == "]" {
            if len(open_brackets) == 0 {
                print("unbalanced ']' at " + str(i));
                return table;
            }
            let start = pop(open_brackets);
            table[start] = i;
            table[i] = start;
        }
    }
    if len(open_brackets) != 0 { print("unbalanced '['"); }
    return table;
}

fn interpret(program: str, tape_size: int) -> str {
    let jumps = jump_table(program);
    var tape: [int] = [];
    for i in 0..tape_size { push(tape, 0); }

    var output = "";
    var pointer = 0;
    var pc = 0;
    var steps = 0;

    while pc < len(program) {
        let c = program[pc];
        if c == ">" {
            pointer += 1;
            if pointer >= tape_size { pointer = 0; }
        } else if c == "<" {
            pointer -= 1;
            if pointer < 0 { pointer = tape_size - 1; }
        } else if c == "+" {
            tape[pointer] = (tape[pointer] + 1) % 256;
        } else if c == "-" {
            tape[pointer] = (tape[pointer] + 255) % 256;
        } else if c == "." {
            output = output + chr(tape[pointer]);
        } else if c == "[" {
            if tape[pointer] == 0 { pc = jumps[pc]; }
        } else if c == "]" {
            if tape[pointer] != 0 { pc = jumps[pc]; }
        }
        pc += 1;
        steps += 1;
    }
    print("(" + str(steps) + " brainfuck instructions executed)");
    return output;
}

fn main() {
    let hello = "++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++.";
    print(interpret(hello, 256));

    // 2 + 5, printed as a digit.
    print(interpret("++>+++++[<+>-]++++++++[<++++++>-]<.", 64));
}
