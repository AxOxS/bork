// Control flow, early returns and string conversion.

fn fizzbuzz(n: int) -> str {
    if n % 15 == 0 { return "FizzBuzz"; }
    if n % 3 == 0  { return "Fizz"; }
    if n % 5 == 0  { return "Buzz"; }
    return str(n);
}

fn main() {
    var line = "";
    for i in 1..21 {
        line = line + fizzbuzz(i);
        if i < 20 { line = line + " "; }
    }
    print(line);
}
