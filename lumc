#!/usr/bin/env python3
"""Entry point for the Lumen compiler."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from lumen import run_source
from lumen.ast_nodes import dump
from lumen.errors import LumenError, LumenRuntimeError
from lumen.lexer import tokenize
from lumen.parser import parse

USAGE = "usage: lumc {run|ast|tokens} <file.lm>\n"


def _read(path):
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read()
    except OSError as exc:
        sys.stderr.write(f"lumc: cannot read {path}: {exc.strerror}\n")
        raise SystemExit(2)


def cmd_tokens(path):
    source = _read(path)
    try:
        for token in tokenize(source, path):
            value = "" if token.value is None else f"  {token.value!r}"
            sys.stdout.write(f"{token.span.line:>4}:{token.span.col:<4} {token.kind:<6}{value}\n")
    except LumenError as exc:
        sys.stderr.write(exc.render() + "\n")
        return 1
    return 0


def cmd_ast(path):
    source = _read(path)
    try:
        sys.stdout.write(dump(parse(source, path)) + "\n")
    except LumenError as exc:
        sys.stderr.write(exc.render() + "\n")
        return 1
    return 0


def cmd_run(path):
    source = _read(path)
    try:
        sys.stdout.write(str(run_source(source, path)) + "\n")
    except LumenError as exc:
        sys.stderr.write(exc.render() + "\n")
        return 1
    except LumenRuntimeError as exc:
        sys.stderr.write(exc.render() + "\n")
        return 70
    return 0


COMMANDS = {"run": cmd_run, "tokens": cmd_tokens, "ast": cmd_ast}


def main(argv):
    if len(argv) == 2 and argv[0] in COMMANDS:
        return COMMANDS[argv[0]](argv[1])
    sys.stderr.write(USAGE)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
