#!/usr/bin/env python3
"""Entry point for the Lumen compiler."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from lumen import compile_source, run_source
from lumen.ast_nodes import dump
from lumen.disasm import disassemble
from lumen.errors import LumenError, LumenRuntimeError, render_diagnostics
from lumen.lexer import tokenize
from lumen.parser import parse

USAGE = "usage: lumc {run|dis|ast|tokens} <file.lm>\n"


def _use_color(stream):
    return stream.isatty() and os.environ.get("NO_COLOR") is None


def _report(exc):
    sys.stderr.write(render_diagnostics(exc.diagnostics, exc.source, exc.filename,
                                        _use_color(sys.stderr)))
    count = len(exc.diagnostics)
    sys.stderr.write(f"lumc: aborting due to {count} error{'s' if count != 1 else ''}\n")
    return 1


def _read(path):
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read()
    except OSError as exc:
        sys.stderr.write(f"lumc: cannot read {path}: {exc.strerror}\n")
        raise SystemExit(2)


def cmd_tokens(path):
    source = _read(path)
    try:
        for token in tokenize(source, path):
            value = "" if token.value is None else f"  {token.value!r}"
            sys.stdout.write(f"{token.span.line:>4}:{token.span.col:<4} {token.kind:<6}{value}\n")
    except LumenError as exc:
        return _report(exc)
    return 0


def cmd_ast(path):
    source = _read(path)
    try:
        sys.stdout.write(dump(parse(source, path)) + "\n")
    except LumenError as exc:
        return _report(exc)
    return 0


def cmd_run(path):
    source = _read(path)
    try:
        run_source(source, path)
    except LumenError as exc:
        return _report(exc)
    except LumenRuntimeError as exc:
        sys.stderr.write(exc.render() + "\n")
        return 70
    return 0


def cmd_dis(path):
    source = _read(path)
    try:
        sys.stdout.write(disassemble(compile_source(source, path).program))
    except LumenError as exc:
        return _report(exc)
    return 0


COMMANDS = {"run": cmd_run, "dis": cmd_dis, "tokens": cmd_tokens, "ast": cmd_ast}


def main(argv):
    if len(argv) == 2 and argv[0] in COMMANDS:
        return COMMANDS[argv[0]](argv[1])
    sys.stderr.write(USAGE)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
